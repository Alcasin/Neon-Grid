%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83fe65bb9f3a45dfa9f518bce11fa542, type: 3}
  m_Name: NeonGrid_Main_Narrative
  m_EditorClassIdentifier: NeonGrid.Runtime::NeonGrid.Data.CampaignNarrativeDefinition
  campaignId: neon_grid_main
  introPages:
  - title: CITY GRID FAILURE
    body: "A cascading power failure has\ndisconnected the city's core systems."
    primaryAction: NEXT
  - title: SYSTEM STATUS
    body: "Most districts are offline.\nAutomatic recovery has failed."
    primaryAction: NEXT
  - title: MANUAL GRID ACCESS
    body: "Operator authorization confirmed.\nManual restoration is available."
    primaryAction: NEXT
  - title: RESTORATION PRIORITY
    body: "Restore the Power Station.\n\nBring the city back online."
    primaryAction: BEGIN RESTORATION
  chapterNarratives:
  - chapterId: power_station
    briefingTitle: POWER STATION
    briefingBody: "Primary generation is offline.\nRestore the local circuits."
    restoredTitle: POWER STATION RESTORED
    restoredBody: "Generation stable.\nDistribution route established."
  - chapterId: substation
    briefingTitle: SUBSTATION
    briefingBody: "Power is available,\nbut distribution remains offline."
    restoredTitle: SUBSTATION RESTORED
    restoredBody: "Distribution network stabilized.\nControl systems are now reachable."
  - chapterId: control_center
    briefingTitle: CONTROL CENTER
    briefingBody: "Grid control remains isolated.\nRestore command routing."
    restoredTitle: CONTROL CENTER RESTORED
    restoredBody: "Command network online.\nAutomated infrastructure detected."
  - chapterId: automation_plant
    briefingTitle: AUTOMATION PLANT
    briefingBody: "Automated infrastructure is offline.\nRestore system coordination."
    restoredTitle: AUTOMATION PLANT RESTORED
    restoredBody: "Automation synchronized.\nCentral Grid access established."
  - chapterId: central_grid
    briefingTitle: CENTRAL GRID
    briefingBody: "All major systems are online.\nReconnect the city's core grid."
    restoredTitle: ''
    restoredBody: ''
  endingNarrative:
    title: GRID RESTORED
    body: All primary city systems are stable.
    statusTitle: 'CITY STATUS: ONLINE'
    statusBody: Restoration complete.
    returnButtonLabel: RETURN TO CITY
